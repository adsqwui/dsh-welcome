{
  "name": "@adsqwui/dsh-welcome",
  "version": "2.2.0",
  "description": "A random greeting, optionally with your name, on the DeepSeek Harness blank chat screen.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "greeting",
    "i18n"
  ],
  "homepage": "https://github.com/adsqwui/dsh-welcome#readme",
  "bugs": {
    "url": "https://github.com/adsqwui/dsh-welcome/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adsqwui/dsh-welcome.git"
  },
  "license": "MIT",
  "author": "adsqwui",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  }
}
